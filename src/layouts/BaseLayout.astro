---
import "../styles/tokens.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  /** Override the header's back-to-home link (shown on every non-home page by default). */
  showBack?: boolean;
}

const siteName = "Utkarsh Arora";
const {
  title,
  description = "Utkarsh Arora: Full Stack developer who sweats motion, type, and how interfaces feel.",
  showBack,
} = Astro.props;

const pageTitle = title ? `${title} · ${siteName}` : `${siteName}, Full Stack Developer`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#fff8ec" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header showBack={showBack} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
