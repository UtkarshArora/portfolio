---
import ProjectCard from "./ProjectCard.astro";
import { projects } from "../data/projects";
import { site } from "../data/site";
---

<section id="projects" class="projects container" aria-labelledby="projects-title">
  <div class="section-head">
    <h2 id="projects-title">
      <span class="index">02</span>
      Projects
    </h2>
    <a class="see-all see-all--external" href={`${site.github}?tab=repositories`}>
      All projects <span aria-hidden="true">↗</span>
    </a>
  </div>

  <ul class="grid" role="list">
    {projects.map((project) => <ProjectCard project={project} />)}
  </ul>
</section>

<style>
  .projects {
    padding-block: var(--space-xl) var(--space-3xl);
    border-top: var(--border-width) solid var(--color-border);
  }

  /* Up to 3 columns. Each card is at least 18rem wide, so narrower screens get fewer columns. */
  .grid {
    --min-col: 18rem;
    display: grid;
    grid-template-columns: repeat(
      auto-fill,
      minmax(max(min(100%, var(--min-col)), (100% - 2 * var(--grid-gap)) / 3), 1fr)
    );
    gap: calc(var(--grid-gap) + var(--base-depth-hover) / 2) var(--grid-gap);
    padding: 0;
    list-style: none;
  }
</style>
