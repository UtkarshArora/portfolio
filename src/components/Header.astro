---
import { site } from "../data/site";

interface Props {
  /** Show an explicit "back to home" link. Defaults to true on every page except the homepage. */
  showBack?: boolean;
}

const isHome = Astro.url.pathname === "/";
const { showBack = !isHome } = Astro.props;

// On the homepage these are in-page anchors; elsewhere they point back to home sections.
const prefix = isHome ? "" : "/";
// Contact is a mailto: link, so it opens the visitor's mail app with To and Subject filled in.
const mailto = `mailto:${site.email}?subject=${encodeURIComponent(site.emailSubject)}`;

interface NavItem {
  label: string;
  href: string;
  /** Accessible name. Must contain the visible label (WCAG 2.5.3, Label in Name). */
  ariaLabel?: string;
  contact?: boolean;
}

const nav: NavItem[] = [
  { label: "Work", href: `${prefix}#work` },
  { label: "Projects", href: `${prefix}#projects` },
  { label: "About", href: `${prefix}#about` },
  { label: "Contact", href: mailto, ariaLabel: "Contact: Email Utkarsh", contact: true },
];
---

<header class="site-header container">
  <div class="brand">
    {
      isHome ? (
        <span class="wordmark">Utkarsh Arora</span>
      ) : (
        <a class="wordmark" href="/">
          Utkarsh Arora
        </a>
      )
    }
    {
      showBack && (
        <a class="back-link mono" href="/">
          <span class="back-arrow" aria-hidden="true">←</span> Back to home
        </a>
      )
    }
  </div>

  <nav aria-label="Primary">
    <ol class="nav-list" role="list">
      {
        nav.map((item, i) => (
          <li>
            <a
              href={item.href}
              aria-label={item.ariaLabel}
              data-contact-link={item.contact ? site.email : undefined}
            >
              <span class="index" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="nav-label">{item.label}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  <!-- Confirmation that the address was copied. Fixed position, so showing it never shifts layout. -->
  <p class="toast" role="status" data-contact-toast></p>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-l);
    padding-block: var(--space-l) var(--space-m);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .brand {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-m);
  }

  .wordmark {
    font-family: var(--font-serif);
    font-size: var(--step-2);
    line-height: 1;
    letter-spacing: var(--tracking-tight);
    color: var(--color-heading);
    text-decoration: none;
  }

  a.wordmark:hover {
    color: var(--color-highlight);
  }

  .back-link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    color: var(--color-accent);
    text-decoration: none;
  }

  .back-arrow {
    display: inline-block;
    transition: transform var(--dur-base) var(--ease-spring);
  }

  .back-link:hover .back-arrow,
  .back-link:focus-visible .back-arrow {
    transform: translateX(-4px);
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-m);
    padding: 0;
    list-style: none;
  }

  .nav-list a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6ch;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-mono);
    color: var(--color-text);
    text-decoration: none;
    /* Comfortable tap target without changing the visual rhythm */
    padding-block: var(--space-3xs);
  }

  .nav-label {
    background: linear-gradient(currentColor, currentColor) no-repeat 0 100% / 0 1px;
    transition: background-size var(--dur-base) var(--ease-out);
  }

  .nav-list a:hover .nav-label,
  .nav-list a:focus-visible .nav-label {
    background-size: 100% 1px;
  }

  .toast {
    position: fixed;
    z-index: var(--z-cursor);
    inset-block-end: var(--space-m);
    inset-inline: 0;
    width: fit-content;
    max-width: calc(100% - 2 * var(--page-gutter));
    margin-inline: auto;
    padding: var(--space-2xs) var(--space-s);
    border-radius: var(--radius-m);
    background: var(--color-heading);
    color: var(--color-bg);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-mono);
    box-shadow: 0 4px 0 var(--btn-primary-base);
    opacity: 0;
    translate: 0 0.75rem;
    pointer-events: none;
    transition:
      opacity var(--dur-base) var(--ease-out),
      translate var(--dur-base) var(--ease-spring);
  }

  .toast:empty {
    visibility: hidden;
  }

  .toast.is-visible {
    opacity: 1;
    translate: 0 0;
  }
</style>

<script>
  // Contact: the mailto: link opens the visitor's mail app. A page can't tell whether that worked
  // (browsers hide it), so we also copy the address on every click. Visitors without a mail app
  // still leave with it.
  const SHOW_FOR = 2600;
  // Every element with data-contact-link (nav Contact, footer Email) shares this behaviour.
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-contact-link]");
  const toast = document.querySelector<HTMLElement>("[data-contact-toast]");
  let timer: number | undefined;

  links.forEach((link) => link.addEventListener("click", async () => {
    // No preventDefault: the browser still follows the mailto: link as normal.
    const email = link.dataset.contactLink;
    if (!email || !toast) return;
    try {
      await navigator.clipboard.writeText(email);
    } catch {
      return; // Clipboard blocked: the mail app (if any) still opens; nothing to confirm.
    }
    toast.textContent = `Email copied`;
    toast.classList.add("is-visible");
    window.clearTimeout(timer);
    timer = window.setTimeout(() => {
      toast.classList.remove("is-visible");
      // Clear after the fade so screen readers don't re-read stale text
      window.setTimeout(() => (toast.textContent = ""), 300);
    }, SHOW_FOR);
  }));
</script>
