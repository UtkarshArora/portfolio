---
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const kindLabel = { repo: "GitHub repository", post: "post", demo: "live demo" }[project.kind];
---

<li class="card" data-tone={project.tone}>
  <article class="card-face">
    <div class="thumb" aria-hidden="true">
      <span class="bar bar--long"></span>
      <span class="bar bar--short"></span>
    </div>
    <div class="card-head">
      <h3 class="card-title">
        <a class="card-link" href={project.href}>
          {project.title}<span class="visually-hidden">, {kindLabel}</span>
        </a>
      </h3>
      <span class="kind" aria-hidden="true">{project.kind}&nbsp;↗</span>
    </div>
    {project.summary && <p class="summary">{project.summary}</p>}
    {
      project.stack && project.stack.length > 0 && (
        <div class="stack">
          <ul role="list" aria-label="Tech stack">
            {project.stack.map((tech) => (
              <li>{tech}</li>
            ))}
          </ul>
        </div>
      )
    }
  </article>
</li>

<style>
  .card {
    --tile: var(--tile-teal);
    position: relative;
    border-radius: var(--radius-l);
  }

  .card[data-tone="burgundy"] {
    --tile: var(--tile-burgundy);
  }
  .card[data-tone="rust"] {
    --tile: var(--tile-rust);
  }

  /* The base the face lifts off. It only appears while the card is hovered or focused. */
  .card::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--btn-primary-base);
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
  }

  .card-face {
    position: relative;
    /* A column where every part keeps its natural size. When a neighbour in the row is taller,
       the stack line drops to the bottom so stacks line up across a row. (Stretching the
       thumbnail instead would also widen it, because of its aspect-ratio.) */
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    height: 100%;
    padding: var(--space-xs) var(--space-xs) var(--space-s);
    border: var(--border-width) solid var(--color-border);
    border-radius: inherit;
    background: var(--color-surface);
    transition:
      transform var(--dur-base) var(--ease-spring),
      border-color var(--dur-base) var(--ease-out);
  }

  .thumb {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    aspect-ratio: 4 / 1.05;
    padding: var(--space-s) var(--space-m);
    border-radius: var(--radius-m);
    background: var(--tile);
    margin-block-end: var(--space-2xs);
  }

  .bar {
    display: block;
    height: 0.6rem;
    border-radius: 999px;
    background: rgb(255 248 236 / 0.55);
  }
  .bar--long {
    width: 32%;
  }
  .bar--short {
    width: 20%;
    opacity: 0.7;
  }

  .card-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    padding-inline: var(--space-2xs);
  }

  .card-title {
    font-size: var(--step-2);
  }

  .card-link {
    color: inherit;
    text-decoration: none;
  }

  /* The whole card is clickable through the title link */
  .card-link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius-l);
  }

  .card-link:focus-visible {
    outline: none;
  }

  .kind {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-mono);
    color: var(--color-highlight);
  }

  .summary {
    padding-inline: var(--space-2xs);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-mono);
    color: var(--color-accent);
  }

  /* "React · TypeScript · FastAPI": quieter than the summary, pinned to the card's bottom edge */
  .stack {
    margin-block-start: auto;
    padding: var(--space-2xs) var(--space-2xs) 0;
    border-top: 1px dashed var(--color-border);
  }

  .stack ul {
    --sep: 2.2ch;
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--sep);
    padding: 0;
    list-style: none;
    /* Every item carries a dot in the gap to its left. Dots that land at the start of a line
       fall outside the list and are clipped, so a wrapped line never begins with "·". */
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: var(--tracking-mono);
    color: var(--color-text-muted);
  }

  .stack li::before {
    content: "·";
    display: inline-block;
    width: var(--sep);
    margin-inline-start: calc(-1 * var(--sep));
    text-align: center;
    color: var(--color-highlight);
  }

  /* Lifted state: hover with a mouse, or keyboard focus */
  .card:has(.card-link:focus-visible)::before {
    opacity: 1;
  }
  .card:has(.card-link:focus-visible) .card-face {
    transform: translateY(calc(-1 * var(--base-depth-hover)));
    border-color: var(--color-heading);
    outline: 2px solid var(--color-focus);
    outline-offset: 4px;
  }

  @media (hover: hover) {
    .card:hover::before {
      opacity: 1;
    }
    .card:hover .card-face {
      transform: translateY(calc(-1 * var(--base-depth-hover)));
      border-color: var(--color-heading);
    }
    .card:active .card-face {
      transform: translateY(calc(-1 * var(--base-depth-active)));
      transition-duration: var(--dur-fast);
    }
  }
</style>
